# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-hidesk-secret
JWT_EXPIRES_IN=8h

# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgres://hidesk:hidesk@localhost:5432/hidesk
PGHOST=localhost
PGPORT=5432
PGUSER=hidesk
PGPASSWORD=hidesk
PGDATABASE=hidesk

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Bootstrap ───────────────────────────────────────────
RUN_MIGRATIONS=true
RUN_SEED=true

# ── Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
