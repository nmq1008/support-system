# Shared environment for docker-compose
PGUSER=hidesk
PGPASSWORD=hidesk
PGDATABASE=hidesk
JWT_SECRET=change-me-in-production-hidesk-secret
CORS_ORIGIN=http://localhost:5173

# Seed the 30-organization operating dataset on first boot (idempotent).
# Set to false (and RUN_SEED=true) for the small starter dataset instead.
RUN_DEMO_SEED=true
RUN_SEED=false
